# ---------------------------------------------------------------------------
# Artivault configuration (copy to .env and adjust for your deployment)
# ---------------------------------------------------------------------------

# Public, absolute base URL of the deployment. Used to build artifact render
# URLs, the OAuth issuer, and to derive the expected WebAuthn origin.
PUBLIC_BASE_URL=http://localhost:8787

# Expected browser Origin header for WebAuthn ceremonies and CSRF checks.
# Usually the origin part of PUBLIC_BASE_URL. Behind a reverse proxy this MUST
# be the public origin, not the internal upstream.
EXPECTED_ORIGIN=http://localhost:8787

# WebAuthn Relying Party ID: the registrable domain, with no scheme or port.
# For localhost development, use "localhost".
RP_ID=localhost

# Human-readable name shown by the browser during passkey prompts.
RP_NAME=Artivault

# --- HTTP server -----------------------------------------------------------
HOST=127.0.0.1
PORT=8787

# Set to true when running behind a TLS-terminating reverse proxy so that
# X-Forwarded-* headers are trusted when resolving the client IP / protocol.
TRUST_PROXY=false

# --- Storage ---------------------------------------------------------------
# Directory holding the main SQLite database and per-dataset SQLite files.
DATA_DIR=./data
# Main database filename, resolved inside DATA_DIR.
DATABASE_FILE=artivault.db

# --- Secrets (generate with: openssl rand -base64 48) — CHANGE THESE --------
SESSION_SECRET=dev-only-change-me-session-secret-please
CSRF_SECRET=dev-only-change-me-csrf-secret-please
CAPABILITY_TOKEN_SECRET=dev-only-change-me-capability-secret-please
OAUTH_TOKEN_SECRET=dev-only-change-me-oauth-secret-please

# --- Lifetimes (seconds) ---------------------------------------------------
SESSION_TTL_SECONDS=1209600        # 14 days
LOCK_TTL_SECONDS=300               # 5 minutes (spec §8)
LOCK_HEARTBEAT_SECONDS=60          # heartbeat refresh interval (spec §8)
CAPABILITY_TOKEN_TTL_SECONDS=120   # short-lived render-data tokens (spec §11)

# --- Environment -----------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
