# ---------------------------------------------------------------------------
# Artivault — Docker deployment config. Copy to `.env.docker` and edit.
#   cp .env.docker.example .env.docker
# docker compose reads this via `env_file`. HOST / PORT / DATA_DIR / NODE_ENV are
# pinned by docker-compose.yml, so you only set the origin, RP, and secrets here.
# ---------------------------------------------------------------------------

# Public origin users load the app from. In Docker the Node server serves BOTH
# the GUI and the API on this single origin (there is no separate Vite server).
#   Local test:        http://localhost:8787
#   Behind a TLS proxy: https://artivault.example.com
PUBLIC_BASE_URL=http://localhost:8787
EXPECTED_ORIGIN=http://localhost:8787

# WebAuthn Relying Party ID: the registrable domain, no scheme or port.
#   "localhost" for local testing; "artivault.example.com" in production.
RP_ID=localhost
RP_NAME=Artivault

# --- Secrets — ⚠️ CHANGE EVERY ONE. Generate with: openssl rand -base64 48 ---
SESSION_SECRET=docker-change-me-session-secret-please-change
CSRF_SECRET=docker-change-me-csrf-secret-please-change
CAPABILITY_TOKEN_SECRET=docker-change-me-capability-secret-please-change
OAUTH_TOKEN_SECRET=docker-change-me-oauth-secret-please-change

# Set true when running behind a TLS-terminating reverse proxy so X-Forwarded-*
# headers are trusted. Leave false when exposing the container's port directly.
TRUST_PROXY=false

LOG_LEVEL=info
