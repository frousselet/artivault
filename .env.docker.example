# ─────────────────────────────────────────────────────────────────────────────
# Artivault — Docker configuration (single source of truth).
#   cp .env.docker.example .env.docker      # then edit the secrets below
#   docker compose --env-file .env.docker up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# Host port to publish, and the app's listen port (kept in sync). If you change
# it, update the URLs below to match.
PORT=8787

# Public origin users load the app from — the Node server serves BOTH the GUI and
# the API here. Behind a TLS proxy, use your real https URL and set TRUST_PROXY.
PUBLIC_BASE_URL=http://localhost:8787
EXPECTED_ORIGIN=http://localhost:8787

# WebAuthn Relying Party: the registrable domain (no scheme or port) + a name.
RP_ID=localhost
RP_NAME=Artivault

# Node base image used at build time (bump to try a newer runtime).
NODE_VERSION=26

# ── Secrets — ⚠️ CHANGE EVERY ONE.  Generate each with: openssl rand -base64 48 ──
SESSION_SECRET=docker-change-me-session-secret-please-change
CSRF_SECRET=docker-change-me-csrf-secret-please-change
CAPABILITY_TOKEN_SECRET=docker-change-me-capability-secret-please-change
OAUTH_TOKEN_SECRET=docker-change-me-oauth-secret-please-change

# Set true behind a TLS-terminating reverse proxy (trusts X-Forwarded-*).
TRUST_PROXY=false

LOG_LEVEL=info
